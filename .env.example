# Ω∞v Oceanicos — Environment Configuration Template
# Copy to .env and fill in production values
# NEVER commit .env to source control

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development

# ─── Signing / Attestation ────────────────────────────────────────────────────
# Override the default signing key (do NOT use default in production)
OMEGA_V_SIGNING_KEY=change-me-in-production-use-a-32-byte-random-hex-string

# ─── Verification Config ──────────────────────────────────────────────────────
# Maximum number of verification rules per engine instance
OMEGA_V_MAX_RULES=100
# Response time threshold for health-check rules (ms)
OMEGA_V_RESPONSE_TIME_THRESHOLD=100
