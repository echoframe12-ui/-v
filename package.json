{
  "name": "@omega-v/oceanicos",
  "version": "0.1.0",
  "private": true,
  "description": "A verification-first full-stack ecosystem for observing, verifying, attesting, and continuously evolving trustworthy intelligence systems.",
  "author": "Ω∞v Community",
  "license": "Apache-2.0",
  "homepage": "https://github.com/starofgodmayomi-droid/omega-v-oceanicos",
  "repository": {
    "type": "git",
    "url": "https://github.com/starofgodmayomi-droid/omega-v-oceanicos.git"
  },
  "type": "module",
  "packageManager": "pnpm@8.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @omega-v/api --filter @omega-v/web dev",
    "build": "pnpm --parallel --filter @omega-v/types --filter @omega-v/observer --filter @omega-v/verification --filter @omega-v/attestation --filter @omega-v/store --filter @omega-v/ir --filter @omega-v/compiler --filter @omega-v/sdk --filter @omega-v/cli --filter @omega-v/agents --filter @omega-v/api --filter @omega-v/web build",
    "clean": "pnpm --parallel --filter @omega-v/api --filter @omega-v/web --filter @omega-v/attestation --filter @omega-v/observer --filter @omega-v/verification --filter @omega-v/types clean && rm -rf coverage",
    "test": "jest",
    "test:fast": "jest --testPathIgnorePatterns=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run test && pnpm run build",
    "verify:fast": "pnpm run lint && pnpm run type-check && pnpm run test:fast",
    "verify:full": "pnpm run lint && pnpm run type-check && pnpm run test:coverage && pnpm run build",
    "docs:build": "echo 'Documentation build (coming soon)'",
    "docs:test": "echo 'Documentation test (coming soon)'",
    "docs:watch": "echo 'Documentation watch (coming soon)'",
    "precommit": "pnpm run lint && pnpm run type-check",
    "prepare": "node -e \"try { require('child_process').execSync('husky install'); } catch {}\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
